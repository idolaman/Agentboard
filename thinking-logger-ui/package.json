{
  "name": "thinking-logger-view",
  "displayName": "Agentboard",
  "version": "0.1.16",
  "private": true,
  "description": "A Cursor/VS Code sidebar to visualize thinking sessions from the MCP server.",
  "publisher": "idolaman",
  "engines": { "vscode": "^1.89.0" },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onView:thinkingLogger.sessions",
    "onCommand:thinkingLogger.clearToken"
  ],
  "icon": "media/white-icon.png",
  "license": "GPL-3.0-only",
  "categories": ["Other"],
  
  "scripts": {
    "build": "tsc -p .",
    "watch": "tsc -w -p .",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint . --ext .ts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "thinkingLogger",
          "title": "Thinking",
          "icon": "./media/brain.svg"
        }
      ]
    },
    "configuration": {
      "title": "Thinking Logger",
      "properties": {
        "thinkingLogger.serverUrl": {
          "type": "string",
          "default": "https://agentboard.onrender.com",
          "description": "Base URL of the Thinking Logger MCP server (HTTP/SSE)."
        }
      }
    },
    "views": {
      "thinkingLogger": [
        {
          "type": "webview",
          "id": "thinkingLogger.sessions",
          "name": "Thinking Sessions"
        }
      ]
    },
    "commands": [
      {
        "command": "thinkingLogger.clearToken",
        "title": "Thinking Logger: Clear Token",
        "category": "Thinking Logger"
      }
    ]
  },
  
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.89.0",
    "typescript": "^5.5.0",
    "eslint": "^9.11.0",
    "@typescript-eslint/eslint-plugin": "^7.16.1",
    "@typescript-eslint/parser": "^7.16.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.3.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.3",
    "zod": "^3.23.8"
  }
}

